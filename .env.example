# Copy to .env (repository root) for local development: cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# Required when DJANGO_DEBUG=false. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Defaults to false if unset. Enable only for local development.
DJANGO_DEBUG=true

# Defaults to true when DEBUG is off. Keep enabled for HTTPS deployment.
# For deliberate local HTTP testing with DEBUG=false only, set this to false.
# DJANGO_SECURE_COOKIES=true

# Comma-separated host names this API may serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins allowed to call /api/* from a browser (the Next.js dashboard).
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Routing provider (OSRM-compatible HTTP API).
# The public OSRM demo server is fine for the assessment: max 1 request/second, no heavy use.
ROUTING_BASE_URL=https://router.project-osrm.org
# Seconds before a routing request is abandoned (connect timeout is capped at 5).
ROUTING_TIMEOUT=10
# Identifying User-Agent, required by the OSRM demo-server usage policy.
ROUTING_USER_AGENT=RouteFuel/0.2 (Spotter AI assessment; Django route planner)
# Seconds a successful route stays cached (default 7 days).
ROUTE_CACHE_TTL=604800

# Fuel-stop optimisation: a station is a candidate when its (town-level) point is within this
# many miles of the route, plus the station's own location uncertainty.
FUEL_CORRIDOR_MILES=5
