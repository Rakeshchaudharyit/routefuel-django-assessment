# Copy to .env (repository root) for local development: cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# Required when DJANGO_DEBUG=false. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Defaults to false if unset. Enable only for local development.
DJANGO_DEBUG=true

# Comma-separated host names this API may serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins allowed to call /api/* from a browser (the Next.js dashboard).
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Routing provider (OSRM-compatible). Used from M2 onwards.
# The public OSRM demo server is fine for the assessment; it is rate-limited.
ROUTING_BASE_URL=https://router.project-osrm.org
# Seconds before a routing request is abandoned.
ROUTING_TIMEOUT=10
